{
  "name": "liquid-agent-desktop",
  "productName": "Liquid Agent",
  "version": "1.0.1",
  "private": true,
  "description": "Liquid Agent for macOS: a window onto the Liquid Agent that runs on this computer.",
  "license": "MIT",
  "author": "Mincoffical",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64 --x64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "codes.mincoffical.liquidagent",
    "productName": "Liquid Agent",
    "copyright": "Mincoffical",
    "files": ["main.cjs", "setup.html", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Liquid Agent listens when you talk to it in voice chat or dictate a message.",
        "NSCameraUsageDescription": "Liquid Agent looks through the camera only when you turn it on in voice chat.",
        "NSAppleEventsUsageDescription": "Liquid Agent can control other apps when you ask it to."
      }
    },
    "dmg": {
      "title": "Liquid Agent",
      "artifactName": "Liquid-Agent-${arch}.dmg"
    }
  }
}
